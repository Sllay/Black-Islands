# Godot
.game/
game/.godot/
game/.import/

# Export/build output
game/builds/
game/export/
game/.mono/

# Reproducible local development toolchain/cache
.tools/

# Serena keeps machine/session state beside its tracked project configuration.
game/.serena/*
!game/.serena/project.yml

# Runtime addons are versioned. Ignore only regenerated import sidecars.
game/addons/zylann.voxel/**/*.import
game/addons/limboai/**/*.import

# Pinned development-only MCP bridge, installed through godot_addon_install.
game/addons/godot_mcp/

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Secrets and local provider configuration
.env
.env.*
!.env.example
**/secrets.*
**/*api_key*

# Temporary harness output
harness/tmp/
harness/artifacts/
