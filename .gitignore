# Godot
.game/
game/.godot/
game/.import/

# Export/build output
game/builds/
game/export/
game/.mono/

# Reproducible local development toolchain/cache
.tools/

# Serena keeps machine/session state beside its tracked project configuration.
game/.serena/*
!game/.serena/project.yml

# Voxel Tools GDExtension binaries are fetched from the pinned release by bootstrap.
game/addons/zylann.voxel/
game/addons/limboai/

# Pinned development-only MCP bridge, installed through godot_addon_install.
game/addons/godot_mcp/

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Secrets and local provider configuration
.env
.env.*
!.env.example
**/secrets.*
**/*api_key*

# Temporary harness output
harness/tmp/
harness/artifacts/
